# Write Chinese/English text with the plotter pen.
#
# Units: mm, mm/s, mm/s^2, mm/s^3.
#
# Numeric defaults use "unset" sentinels so the skill config wins:
#   * font_size_mm <= 0      -> config
#   * line_spacing  <= 0      -> config
#   * letter_spacing_mm <= 0  -> config
#   * origin_x <= 0           -> config
#   * origin_y <= 0           -> config; a configured negative value selects
#                               the default (text block top-aligned at the
#                               workspace top)
#
# MCP dataclasses fill omitted numeric fields with 0, so 0 is the "use the
# configured default" sentinel for every numeric option above. To request an
# explicit zero spacing/origin, set that value in the skill config.
#
# Leave workspace.x_max <= workspace.x_min (the default) to use the
# configured workspace. When supplied, workspace.z_up <= z_down falls
# back to the configured pen heights.
#
# Supported characters: ASCII A-Z a-z 0-9, space, newline, and the 3755
# GB2312 level-1 hanzi in the vendored single-stroke font. Punctuation is
# not in the font and returns success=false.
#
# The global motion profile (velocity/acceleration/deceleration/jerk,
# pen heights) is owned by the plotter primitive and is not a parameter
# here: change it with plotter_set_params. This tool never calls
# SET_PARAM, so user-selected values persist across writes.
string  text
float64 font_size_mm
float64 line_spacing
float64 letter_spacing_mm
float64 origin_x
float64 origin_y
# Plan only: return point count and bounds, do not move the machine.
bool    dry_run
# Run the primitive HOME routine after a successful write.
bool    auto_home
plot/Workspace workspace
---
bool    success
string  message
# Number of waypoints in the plan (pen-up/down included).
uint32  points
float64 min_x
float64 max_x
float64 min_y
float64 max_y
float64 elapsed_s